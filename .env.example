# Copy to .env.local and fill in. Never commit real values.

# --- Public (safe in the browser) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase "publishable" key (older projects call it the anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Supabase "secret" key (older projects call it the service_role key). Bypasses row level security.
SUPABASE_SECRET_KEY=
# Instagram Graph API version used by the importer
INSTAGRAM_API_VERSION=v25.0
# Numeric ID of the connected Instagram account. Needed only for Facebook-issued ("EAA...") tokens from Meta's Unified login.
INSTAGRAM_ACCOUNT_ID=
